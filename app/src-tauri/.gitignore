# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (built by PyInstaller)
# These are generated with: python python/build.py
/binaries/

# Python build artifacts
/python/build/
/python/dist/
/python/__pycache__/
/python/mappings/__pycache__/
/python/tests/__pycache__/
/python/*.spec
/python/*.png
/python/.pytest_cache/
